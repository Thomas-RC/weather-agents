FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Najpierw tylko pyproject.toml — cache warstwy zależności
COPY pyproject.toml ./
RUN pip install --no-cache-dir \
    "google-adk>=1.18.0" \
    "google-genai>=1.0.0" \
    "google-cloud-aiplatform[all]>=1.71.0" \
    "qdrant-client>=1.13.0" \
    "boto3>=1.35.0" \
    "sqlalchemy>=2.0.0" \
    "pymysql>=1.1.0" \
    "cryptography>=43.0.0" \
    "apscheduler>=3.10.0" \
    "requests>=2.32.0" \
    "pillow>=11.0.0" \
    "pydantic>=2.9.0" \
    "pydantic-settings>=2.6.0" \
    "structlog>=24.4.0" \
    "tenacity>=9.0.0"

COPY src ./src
COPY scripts ./scripts

CMD ["python", "-m", "src.worker.scheduler"]
