# Vertex AI / Gemini
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
# Ścieżka WIDZIANA Z WNĘTRZA KONTENERA (mount w docker-compose):
GOOGLE_APPLICATION_CREDENTIALS=/gcp/sa-key.json
# Ścieżka na hoście do pliku JSON service account (mount source):
GOOGLE_SA_KEY_FILE=./secrets/sa-key.json
GEMINI_MODEL_ROUTER=gemini-2.5-pro
GEMINI_MODEL_CAPTION=gemini-2.5-flash
GEMINI_TEXT_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MM_EMBEDDING_MODEL=multimodalembedding@001

# Qdrant (lokalnie, hasło niepotrzebne)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_RADAR=radar
QDRANT_COLLECTION_SATELLITE=satellite
QDRANT_COLLECTION_TEXT=text_chunks

# MinIO (lokalnie, defaults do dev)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=weather
MINIO_SECRET_KEY=weather123
MINIO_BUCKET=weather-rag-raw
MINIO_SECURE=false

# MariaDB (lokalnie, defaults do dev)
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_USER=weather
MARIADB_PASSWORD=weather
MARIADB_ROOT_PASSWORD=weather-root
MARIADB_DATABASE=weather_rag

# App
APP_LOG_LEVEL=INFO
APP_ENV=dev
